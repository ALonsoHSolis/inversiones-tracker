  "keyframes": [
    {
      "nombre": "slide-in-from-bottom",
      "css": "@keyframes slide-in-from-bottom { 0% { transform: translateY(100%); } 100% { transform: translateY(0px); } }"
    },
    {
      "nombre": "slide-in-from-top",
      "css": "@keyframes slide-in-from-top { 0% { transform: translateY(-100%); } 100% { transform: translateY(0px); } }"
    },
    {
      "nombre": "slide-in-from-left",
      "css": "@keyframes slide-in-from-left { 0% { transform: translate(-100%); } 100% { transform: translate(0px); } }"
    },
    {
      "nombre": "slide-in-from-right",
      "css": "@keyframes slide-in-from-right { 0% { transform: translate(100%); } 100% { transform: translate(0px); } }"
    },
    {
      "nombre": "text-from-top",
      "css": "@keyframes text-from-top { 0% { margin-top: -4rem; padding-bottom: 4rem; } 100% { margin-top: 0rem; margin-bottom: 0rem; } }"
    },
    {
      "nombre": "moveUpDown",
      "css": "@keyframes moveUpDown { 0% { transform: translateY(0px); } 50% { transform: translateY(-35px); } 100% { transform: translateY(0px); } }"
    },
    {
      "nombre": "moveUpDownPhone",
      "css": "@keyframes moveUpDownPhone { 0% { transform: translateY(0px); } 50% { transform: translateY(-20px); } 100% { transform: translateY(0px); } }"
    },
    {
      "nombre": "fadeInUp",
      "css": "@keyframes fadeInUp { 0% { opacity: 0; transform: translateY(10vh); } 100% { opacity: 1; transform: translateY(0px); } }"
    },
    {
      "nombre": "fadeInUpMobile",
      "css": "@keyframes fadeInUpMobile { 0% { opacity: 0; transform: translateY(5vh); } 100% { opacity: 1; transform: translateY(0px); } }"
    },
    {
      "nombre": "fadeInOnly",
      "css": "@keyframes fadeInOnly { 0% { opacity: 0; } 100% { opacity: 1; } }"
    },
    {
      "nombre": "fadeInUpCentered",
      "css": "@keyframes fadeInUpCentered { 0% { opacity: 0; transform: translate(-50%, -40%); } 100% { opacity: 1; transform: translate(-50%, -50%); } }"
    },
    {
      "nombre": "skipo-dot-bounce-cd3800a8",
      "css": "@keyframes skipo-dot-bounce-cd3800a8 { 0%, 60%, 100% { transform: translateY(0px); opacity: 0.5; } 30% { transform: translateY(-8px); opacity: 1; } }"
    },
    {
      "nombre": "skipo-contact-spin-927d636b",
      "css": "@keyframes skipo-contact-spin-927d636b { 100% { transform: rotate(360deg); } }"
    },
    {
      "nombre": "skipo-bounce-dac3fdca",
      "css": "@keyframes skipo-bounce-dac3fdca { 0%, 60%, 100% { transform: translateY(1px); } 30% { transform: translateY(-3px); } }"
    },
    {
      "nombre": "skipo-blink-dac3fdca",
      "css": "@keyframes skipo-blink-dac3fdca { 50% { opacity: 0; } }"
    },
    {
      "nombre": "skipo-bounce-67e2c5c3",
      "css": "@keyframes skipo-bounce-67e2c5c3 { 0%, 60%, 100% { transform: translateY(0px); } 30% { transform: translateY(-6px); } }"
    },
    {
      "nombre": "skipo-spin-07619a0c",
      "css": "@keyframes skipo-spin-07619a0c { 100% { transform: rotate(360deg); } }"
    }
