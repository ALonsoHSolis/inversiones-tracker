  "clases_animacion": [
    {
      "selector": ".transition-bottom",
      "animation": "1s ease 0s 1 normal none running slide-in-from-bottom"
    },
    {
      "selector": ".transition-top",
      "animation": "1s ease 0s 1 normal none running slide-in-from-top"
    },
    {
      "selector": ".transition-left",
      "animation": "1s ease 0s 1 normal none running slide-in-from-left"
    },
    {
      "selector": ".transition-right",
      "animation": "1s ease 0s 1 normal none running slide-in-from-right"
    },
    {
      "selector": ".transition-text",
      "animation": "1s ease 0s 1 normal none running text-from-top"
    },
    {
      "selector": ".transition-fade-in-up",
      "animation": "0.6s ease-out 0s 1 normal forwards running fadeInUp"
    },
