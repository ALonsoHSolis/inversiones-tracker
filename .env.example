NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# solo servidor -- nunca con prefijo NEXT_PUBLIC_. bypassea rls, la usa
# src/lib/supabase/admin.ts para el cron de recordatorios (Settings > API
# en el dashboard de supabase).
SUPABASE_SERVICE_ROLE_KEY=

# resend.com -- envio de correo del cron de recordatorios semanales
RESEND_API_KEY=
# remitente verificado en resend; si se deja vacio, cae a onboarding@resend.dev
# (solo sirve para pruebas, no para produccion real)
RESEND_FROM_EMAIL=

# protege /api/cron/recordatorios de invocaciones externas -- vercel manda
# este mismo valor en el header Authorization al disparar el cron
CRON_SECRET=
